# Copia questo file in ".env.local" (per provare in locale) e inserisci i valori.
# Su Vercel le stesse variabili vanno in Project Settings → Environment Variables.
# NON mettere mai valori reali in questo file.

# --- OBBLIGATORIE ---
# Supabase → Project Settings → API Keys → "service_role" (segreta! solo lato server)
SUPABASE_SERVICE_ROLE_KEY=

# --- PAGAMENTI (Stripe) ---
# Stripe → Developers → API keys → Secret key (sk_live_... o sk_test_...)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://yeppo.it/api/stripe/webhook → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Facoltativo: "1" per far calcolare l'IVA a Stripe Tax
STRIPE_AUTOMATIC_TAX=

# --- AI ---
# Su Vercel NON serve nulla: si usa Vercel AI Gateway (crediti gratuiti mensili).
# In locale: Vercel → AI Gateway → API Keys.
AI_GATEWAY_API_KEY=
# Facoltativi: modello per l'analisi e modello con ricerca web per trovare le aziende
AI_MODEL=
DISCOVERY_MODEL=
# Facoltativo: se impostata, l'analisi usa Google Gemini direttamente
GEMINI_API_KEY=

# --- FACOLTATIVE ---
# Predefiniti: progetto Supabase "yeppo" e https://yeppo.it
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=
