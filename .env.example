# Copia questo file in ".env.local" (per provare in locale) e inserisci i valori.
# Su Vercel le stesse variabili vanno in Project Settings → Environment Variables.
# NON mettere mai valori reali in questo file.

# --- OBBLIGATORIE ---
# Supabase → Project Settings → API Keys → "service_role" (segreta! solo lato server)
SUPABASE_SERVICE_ROLE_KEY=
# Password dell'area riservata (scegline una lunga)
ADMIN_PASSWORD=

# --- AI ---
# Su Vercel NON serve nulla: si usa Vercel AI Gateway con i crediti gratuiti mensili.
# In locale: crea una chiave su Vercel → AI Gateway → API Keys.
AI_GATEWAY_API_KEY=
# Facoltativo: modello da usare tramite AI Gateway (predefinito google/gemini-2.5-flash)
AI_MODEL=
# Facoltativo: se la imposti, Zeppo usa Google Gemini direttamente invece di AI Gateway
GEMINI_API_KEY=

# --- FACOLTATIVE ---
# Predefinito: il progetto Supabase "yeppo"
SUPABASE_URL=
# Indirizzo pubblico del sito, senza slash finale (es. https://yeppo.it)
NEXT_PUBLIC_SITE_URL=
