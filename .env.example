# Copia questo file in ".env.local" (per provare in locale) e inserisci i valori.
# Su Vercel le stesse variabili vanno in Project Settings → Environment Variables.
# NON mettere mai valori reali in questo file.

# Chiave API di Google Gemini (Google AI Studio → Get API key)
GEMINI_API_KEY=

# Supabase → Project Settings → API (o "Data API")
SUPABASE_URL=
# Supabase → Project Settings → API Keys → "service_role" (segreta! solo lato server)
SUPABASE_SERVICE_ROLE_KEY=

# Password dell'area riservata (scegline una lunga)
ADMIN_PASSWORD=

# Indirizzo pubblico del sito, senza slash finale (es. https://yeppo.it)
NEXT_PUBLIC_SITE_URL=
