{
  "manifest_version": 3,
  "name": "yeppo",
  "version": "2.4.0",
  "description": "yeppo reads the Solana memecoin you are looking at: safety, the creator's past coins, and the moment. Momentum, Wait or Don't buy. Needs a yeppo Pro key.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "yeppo",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "notifications",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pump.fun/*",
        "https://*.pump.fun/*",
        "https://gmgn.ai/*",
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://photon-sol.tinyastro.io/*",
        "https://bullx.io/*",
        "https://*.bullx.io/*",
        "https://dexscreener.com/*",
        "https://birdeye.so/*",
        "https://solscan.io/*",
        "https://jup.ag/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://yeppo.it/*",
        "https://www.yeppo.it/*"
      ],
      "js": [
        "link.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "frame.html"
      ],
      "matches": [
        "https://pump.fun/*",
        "https://*.pump.fun/*",
        "https://gmgn.ai/*",
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://photon-sol.tinyastro.io/*",
        "https://bullx.io/*",
        "https://*.bullx.io/*",
        "https://dexscreener.com/*",
        "https://birdeye.so/*",
        "https://solscan.io/*",
        "https://jup.ag/*"
      ]
    }
  ]
}
