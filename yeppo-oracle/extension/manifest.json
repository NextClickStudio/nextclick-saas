{
  "manifest_version": 3,
  "name": "yeppo",
  "version": "3.4.0",
  "description": "yeppo reads the Solana memecoin you are looking at: launch bundle, real holders, the creator and who funded them, same-amount buys, your wallet radar. One word: Safe, Risky or Danger. Needs a yeppo Pro key.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "yeppo",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "cookies"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pump.fun/*",
        "https://*.pump.fun/*",
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*",
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://photon-sol.tinyastro.io/*",
        "https://bullx.io/*",
        "https://*.bullx.io/*",
        "https://dexscreener.com/*",
        "https://birdeye.so/*",
        "https://solscan.io/*",
        "https://jup.ag/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://yeppo.it/*",
        "https://www.yeppo.it/*"
      ],
      "js": [
        "link.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://j7tracker.io/*"
      ],
      "js": [
        "j7.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://j7tracker.io/*",
    "https://*.j7tracker.io/*"
  ]
}
