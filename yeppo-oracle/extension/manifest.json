{
  "manifest_version": 3,
  "name": "yeppo oracle",
  "version": "1.0.0",
  "description": "Spots the memecoin you are looking at and tells you, in plain words, what usually happens next to coins like it.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "yeppo oracle",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pump.fun/*",
        "https://*.pump.fun/*",
        "https://gmgn.ai/*",
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://photon-sol.tinyastro.io/*",
        "https://bullx.io/*",
        "https://*.bullx.io/*",
        "https://dexscreener.com/*",
        "https://birdeye.so/*",
        "https://solscan.io/*",
        "https://jup.ag/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "frame.html"
      ],
      "matches": [
        "https://pump.fun/*",
        "https://*.pump.fun/*",
        "https://gmgn.ai/*",
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://photon-sol.tinyastro.io/*",
        "https://bullx.io/*",
        "https://*.bullx.io/*",
        "https://dexscreener.com/*",
        "https://birdeye.so/*",
        "https://solscan.io/*",
        "https://jup.ag/*"
      ]
    }
  ]
}
