# Necessaria per creare percorsi su QUALSIASI argomento (video da YouTube Shorts).
# Senza, l'app gira in modalità demo con 9 percorsi già pronti. Come ottenerla: README.md
YOUTUBE_API_KEY=

# Consigliata: l'AI (Gemini) disegna il percorso su misura, legge "cosa sai già"
# e sceglie i video giusti per ogni passo.
# Vanno bene anche i nomi GOOGLE_GENERATIVE_AI_API_KEY o GOOGLE_API_KEY.
GEMINI_API_KEY=

# Facoltativo: modello Gemini (di default gemini-flash-latest, poi gemini-2.5-flash).
GEMINI_MODEL=

# Facoltativo: email di contatto mostrata nelle pagine legali.
NEXT_PUBLIC_CONTACT_EMAIL=

# Facoltativo: URL pubblico, per le anteprime dei link condivisi.
NEXT_PUBLIC_SITE_URL=
