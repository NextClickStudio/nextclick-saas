# Maison — environment variables (copy to .env.local). Never commit real secrets.

# Supabase project (Settings → API). The publishable/anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admins are listed in the maison_config table (key "admins"); see scripts/seed-sql.ts.
# Edge Function secrets (Supabase → Edge Functions → Secrets):
#   SERPAPI_KEY      optional, switches the market to SerpApi Google Trends
#   MARKET_FALLBACK  "sim" (default) or "none"
